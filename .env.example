# Optional. If both are set, the whole site requires HTTP basic auth.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional. Used in health/logs only.
PUBLIC_BASE_URL=

# Hosts set this automatically. Local default is 8000.
# PORT=8000

# Snowflake programmatic access token for user DANZAG88.
# Copy this file to .env and paste the secret after the equals sign.
# Never commit the value. The Snowflake CLI reads the same secret from
# .secrets/snowflake_pat (one line, token only).
SNOWFLAKE_PAT=
